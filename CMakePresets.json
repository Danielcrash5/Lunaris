{
  "version": 6,
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Lunaris (Ninja)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "LUNARIS_BUILD_TESTS": "ON",
        "LUNARIS_BUILD_EXAMPLES": "ON"
      }
    },
    {
      "name": "sanitize",
      "displayName": "Lunaris (Ninja, ASan + UBSan, Linux)",
      "inherits": "default",
      "binaryDir": "${sourceDir}/build-sanitize",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "sanitize",
      "configurePreset": "sanitize"
    }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "sanitize",
      "inherits": "default",
      "configurePreset": "sanitize"
    }
  ]
}
